{
  "name": "agabi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "node dev-backend/server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "probe": "node scripts/probe-providers.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "dataset:build": "tsx --env-file=.env.local scripts/build-dataset.ts",
    "populate": "tsx --env-file=.env.local scripts/populate-corpus.ts",
    "ingest:corpus": "tsx --env-file=.env.local scripts/ingest-corpus.ts",
    "search:probe": "tsx --env-file=.env.local scripts/search-probe.ts",
    "web:probe": "tsx --env-file=.env.local scripts/web-probe.ts",
    "populate:sample": "tsx --env-file=.env.local scripts/populate.ts",
    "quality": "tsx --env-file=.env.local scripts/quality.ts",
    "sample": "tsx --env-file=.env.local scripts/sample-store.ts",
    "verify:graph": "tsx --env-file=.env.local scripts/verify-graph.ts",
    "review:export": "tsx --env-file=.env.local scripts/review-export.ts",
    "review:submit": "tsx --env-file=.env.local scripts/review-submit.ts",
    "export:knowledge": "tsx --env-file=.env.local scripts/export-knowledge.ts",
    "import:knowledge": "tsx --env-file=.env.local scripts/import-knowledge.ts",
    "verify:roundtrip": "tsx --env-file=.env.local scripts/verify-roundtrip.ts",
    "report:population": "tsx --env-file=.env.local scripts/report-population.ts",
    "gate": "npm run check:tests && npx tsc --noEmit && npm run lint && npx vitest run --coverage",
    "gate:full": "npm run gate && npm run build",
    "guard:nodevbuild": "node scripts/guard-no-dev-build.mjs",
    "prebuild": "node scripts/guard-no-dev-build.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
