    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tldraw": "^5.2.5",
    "vis-data": "^8.0.4",
    "vis-timeline": "^8.5.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
