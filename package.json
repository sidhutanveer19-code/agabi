    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.185.1",
    "@xyflow/react": "^12.11.2",
    "3dmol": "^2.5.5",
    "ai": "^7.0.32",
    "class-variance-authority": "^0.7.1",
