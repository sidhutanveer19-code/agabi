// Agabi backend — Phase 1 spine. 3 tables. YAGNI on code, not on data capture.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (app)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

model Workspace {
  id        String   @id
  userId    String // Clerk/dev user id. No local User table — auth is the user store.
  doc       Json
  camera    Json
  title     String? // canvas title = the first lesson's topic (stamped once, at first lesson)
  subject   String? // classifySubject(topic) — a subjectAccent key; null → violet dot
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt]) // newest-first "Recent" list
}

model Event {
  // append-only. no consumers yet, by design. purge-by-userId only.
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  type      String
  payload   Json
  source    String // "server" (trusted) | "client" (not)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Lesson {
  // A lesson as an ENTITY (not a stream). cursor = where teaching is; slots = the
  // full repaired outline. The DB is the source of truth — serverless has no memory.
  id        String   @id @default(cuid())
  userId    String
  canvasId  String
  regionId  String
  topic     String
  slots     Json
  cursor    Int      @default(0)
  state     String   @default("IDLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, canvasId])
}

model Session {
  // What "currently teaching" means: activeLessonId. One per (user, canvas).
  id             String   @id @default(cuid())
  userId         String
  canvasId       String
  activeLessonId String?
  updatedAt      DateTime @updatedAt

  @@unique([userId, canvasId])
}

model RateHit {
  // shared rate-limit ledger [I3] — in-memory limiting is decorative on serverless.
  // NOT YET ACTIVE: needs `prisma migrate` before the route switches to it.
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Consent {
  // schema only. empty. no UI, no logic. reserved for the DPDP/minor gate.
  id          String    @id @default(cuid())
  userId      String
  guardianRef String?
  method      String?
  grantedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
