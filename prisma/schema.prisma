// Agabi backend — Phase 1 spine. 3 tables. YAGNI on code, not on data capture.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (app)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

model Workspace {
  id        String   @id
  userId    String // Clerk/dev user id. No local User table — auth is the user store.
  doc       Json
  camera    Json
  title     String? // canvas title = the first lesson's topic (stamped once, at first lesson)
  subject   String? // classifySubject(topic) — a subjectAccent key; null → violet dot
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt]) // newest-first "Recent" list
}

model Event {
  // append-only flight recorder. purge-by-userId only (DPDP erasure).
  // id: OLD rows are cuid, NEW rows are crypto.randomUUID() — NEVER sort by id or assume a format.
  // Ordering is `seq` (bigserial) ALONE — createdAt collides inside a createMany batch.
  id              String   @id // caller-supplied now (was @default(cuid()))
  userId          String
  conversationId  String? // stable per (userId, canvasId) — canvas lifetime (was the misnamed sessionId)
  lessonId        String?
  reqId           String? // one HTTP request
  seq             BigInt   @default(autoincrement()) // ordering only — no read, no race
  tier            Int      @default(2) // 1 never-lost · 2 retry/queue · 3 best-effort
  type            String
  payload         Json
  eventVersion    Int      @default(1) // this type's payload shape
  schemaVersion   Int      @default(1) // the envelope
  provenance      Json? // { promptVersion, modelId, providerName, pipelineVersion, ... }
  causedByEventId String?
  source          String // "server" (trusted) | "client" (not)
  createdAt       DateTime @default(now())

  @@index([lessonId, seq])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Outbox {
  // Tier-1/2 evidence whose direct insert failed (transient) — drained opportunistically.
  // id = the FAILED event's id, so causedByEventId chains survive the round-trip.
  id              String    @id
  userId          String
  tier            Int
  type            String
  payload         Json
  conversationId  String?
  lessonId        String?
  reqId           String?
  eventVersion    Int       @default(1)
  schemaVersion   Int       @default(1)
  provenance      Json?
  causedByEventId String?
  retryCount      Int       @default(0)
  nextRetryAt     DateTime?
  firstFailure    DateTime  @default(now())
  lastFailure     DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([nextRetryAt])
}

model Lesson {
  // A lesson as an ENTITY (not a stream). cursor = where teaching is; slots = the
  // full repaired outline. The DB is the source of truth — serverless has no memory.
  id        String   @id @default(cuid())
  userId    String
  canvasId  String
  regionId  String
  topic     String
  slots     Json
  cursor    Int      @default(0)
  state     String   @default("IDLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, canvasId])
}

model Session {
  // What "currently teaching" means: activeLessonId. One per (user, canvas).
  id             String   @id @default(cuid())
  userId         String
  canvasId       String
  activeLessonId String?
  updatedAt      DateTime @updatedAt

  @@unique([userId, canvasId])
}

model RateHit {
  // shared rate-limit ledger [I3] — in-memory limiting is decorative on serverless.
  // NOT YET ACTIVE: needs `prisma migrate` before the route switches to it.
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Consent {
  // schema only. empty. no UI, no logic. reserved for the DPDP/minor gate.
  id          String    @id @default(cuid())
  userId      String
  guardianRef String?
  method      String?
  grantedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
